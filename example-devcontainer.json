{
  "name": "{title}",
  "build": { "dockerfile": "Dockerfile" },
  "runArgs": ["--add-host=host.docker.internal:host-gateway"],
  "mounts": ["source=/var/run/docker.sock,target=/var/run/docker.sock,type=bind"],
  "postStartCommand": "s=/var/run/docker.sock; [ -S $s ] || exit 0; g=$(stat -c %g $s); n=$(awk -F: -v g=$g '$3==g{print $1; exit}' /etc/group); [ -n \"$n\" ] || { sudo groupadd -g $g docker-host && n=docker-host; }; id -nG dev | grep -qw \"$n\" || sudo usermod -aG \"$n\" dev",
  "waitFor": "postStartCommand",
  "remoteUser": "dev",
  "updateRemoteUserUID": true,
  "remoteEnv": { "WARPENGINE_DEVCONTAINER": "1" },
  "customizations": {
    "vscode": {
      "extensions": [
        "TeletypeGames.warpengine-toolbox",
        "ms-vscode.makefile-tools",
        "sumneko.lua",
        "informagico.vscode-lua-minify"
      ],
      "settings": {
        "makefile.configureOnOpen": false,
        "makefile.configureOnEdit": false,
        "makefile.configureAfterCommand": false,
        "Lua.diagnostics.globals": ["TIC", "BOOT", "SCN", "BDR", "OVR", "MENU", "btn", "btnp", "key", "keyp", "mouse", "cls", "pix", "line", "rect", "rectb", "circ", "circb", "elli", "ellib", "tri", "trib", "textri", "ttri", "spr", "map", "mget", "mset", "font", "print", "clip", "peek", "peek1", "peek2", "peek4", "poke", "poke1", "poke2", "poke4", "memcpy", "memset", "pmem", "sfx", "music", "sync", "vbank", "fget", "fset", "exit", "reset", "time", "tstamp", "trace"]
      }
    }
  }
}
