  "tasks": [
    {
      "label": "build",
      "type": "warpengine",
      "target": "build",
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "lint",
      "type": "warpengine",
      "target": "lint"
    },
    {
